# =====================================================
# Discord Music Bot - Beispielkonfiguration
# Kopiere diese Datei zu "config.properties" und trage
# deine eigenen Werte ein.
# =====================================================

# Discord Bot Token (https://discord.com/developers/applications)
bot.token=DEIN_DISCORD_BOT_TOKEN

# Standard-Lautstaerke (0-100)
bot.volume=50

# Bot Status (wird im Discord-Profil angezeigt)
bot.status=Musik | /help

# Bot Owner Name (wird in /info angezeigt)
bot.owner=DeinName

# Bot Owner Discord User ID (fuer owner-only Commands wie /dcleave)
bot.owner.id=000000000000000000

# Support/Kontakt (wird in /info angezeigt)
bot.support=Bei Problemen melde dich bei mir

# Spotify API (https://developer.spotify.com/dashboard)
# Optional - nur noetig wenn du Spotify-Links abspielen willst
spotify.client.id=
spotify.client.secret=

# Nonstop / Auto-Nonstop Suchbegriffe (Komma-getrennt). Leer = Standard-Werte
# Beispiel: nonstop.genres=techno,hardstyle,rock,80er
nonstop.genres=
nonstop.modifiers=

# =====================================================
# YouTube (dev.lavalink.youtube) - BEHEBT LADEFEHLER
# =====================================================

# PO-Token + VisitorData (empfohlen bei: "No supported audio streams available")
# Erhalte diese hier: https://github.com/youtube/yt-dlp#user-content-po-token-guide
# Optional - leer lassen wenn nicht vorhanden.
youtube.po.token=
youtube.po.visitor.data=

# OAuth2 - behebt "This video requires login" (Altersbeschraenkung, private Videos)
#
# Variante A (einfach): oauth.enabled=true setzen, Bot starten -> der Login-Link
#   und ein Code erscheinen im Terminal. Link im Browser oeffnen, Google-Konto
#   waehlen, Code eintragen. Danach steht der Refresh-Token in config.properties.
# Variante B (direkt): Refresh-Token schon bekannt -> hier eintragen.
# Optional - leer lassen wenn nicht vorhanden.
youtube.oauth.enabled=false
youtube.oauth.refresh.token=

